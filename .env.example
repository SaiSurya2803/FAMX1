# FAMX1 / Kinsutra AI Environment Variables Configuration
# Copy this file to .env or .env.local to configure AI services.

# Google Gemini API Key (Recommended - used by Kinsutra AI for Lounsbury Kinship parsing and natural text tree extraction)
# Get a key at https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# OpenAI API Key (Optional fallback - used if Gemini key is absent)
# Get a key at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
